{
  "name": "eslint-plugin-astro-standards",
  "version": "1.0.2",
  "description": "ESLint plugin to enforce Astro best practices: mandatory base layout, SEO props, and no raw HTML structure in pages",
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "astro",
    "seo",
    "layout",
    "best-practices"
  ],
  "author": "Erick Cruz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErickCSS/eslint-plugin-astro-standards"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:astro-pages": "eslint src/pages/**/*.astro",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0",
    "eslint-plugin-astro": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-astro": {
      "optional": false
    }
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.57.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.0",
    "eslint": "^9.22.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3"
  }
}
