{
  "name": "eslint-plugin-astro-standards",
  "version": "1.0.0",
  "description": "ESLint plugin to enforce Astro best practices: mandatory base layout, SEO props, and no raw HTML structure in pages",
  "type": "module",
  "main": "./eslint/plugin.js",
  "exports": {
    ".": "./eslint/plugin.js"
  },
  "files": [
    "eslint"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "astro",
    "seo",
    "layout",
    "best-practices"
  ],
  "author": "Erick Cruz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/eslint-plugin-astro-standards.git"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:astro-pages": "eslint src/pages/**/*.astro"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0",
    "eslint-plugin-astro": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-astro": {
      "optional": false
    }
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.57.0"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript": "^5.9.3"
  }
}
